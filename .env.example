POSTGRES_USER=mandi
POSTGRES_PASSWORD=mandi_dev_password
POSTGRES_DB=mandi
DATABASE_URL=postgres://mandi:mandi_dev_password@postgres:5432/mandi

JWT_SECRET=change_me

# Frontend → backend URL, used by the Next.js app.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: swap the seeded mandi_prices table for the real government feed.
# Get a key at https://data.gov.in/user/register — resource id for daily mandi
# prices is "9ef84268-d588-465a-a308-a864a43d0070" (Variety-wise Daily Market
# Prices Data of Commodity, Ministry of Agriculture). Left blank, the app just
# uses the seeded data in backend/src/db/init.sql.
AGMARKNET_API_KEY=
